{
  "name": "vibedelib-frontend",
  "private": true,
  "version": "0.42.0",
  "license": "SEE LICENSE IN LICENCE.md",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-legal.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs && node scripts/copy-legal.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5160",
    "dev:elus": "vite --config vite.elus.config.ts",
    "build:elus": "tsc --noEmit && vite build --config vite.elus.config.ts"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.1.0",
    "@tiptap/extension-placeholder": "^2.27.3",
