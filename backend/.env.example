# ---- Base de données (PostgreSQL partagé de la Ville) ----
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=ivry_admin
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_SCHEMA=ivrydelib
# ---- API centrale APM (AD, mail, SMS, IA) ----
APM_API_URL=https://api.ivry.local
APM_API_KEY=
# ---- API métier Hub DSI (organisation, agents, élus) ----
HUBDSI_API_URL=
HUBDSI_API_KEY=
# ---- TLS interne : autorité de certification (préféré) ou contournement limité aux clients APM/Hub ----
VILLE_CA_FILE=
VILLE_ALLOW_SELF_SIGNED_CERTS=false
# ---- Application ----
PORT=3021
NODE_ENV=production
JWT_SECRET=
JWT_TTL=8h
SESSION_MAX_HOURS=24
# « Se souvenir de moi » : durée maximale de la session persistante (jours, 183 au plus) ; elle prend fin à la déconnexion
SESSION_SOUVENIR_DAYS=182
BOOTSTRAP_ADMINS=
DEFAULT_ORGANISME_NAME=Ville
LOCAL_ADMIN_ENABLED=true
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5160
TRUST_PROXY=false
RLS_ENABLED=false
AUTO_MIGRATE=true
DIRECTORY_CACHE_TTL_MIN=60
LOG_LEVEL=info
# ---- Fichiers, mails, tâches planifiées ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
MAIL_REDIRECT_TO=
SCHEDULER_ENABLED=false
PUBLIC_BASE_URL=http://localhost:5160
ANNOTATIONS_KEY=
# ---- Bureau en ligne : édition Word / Excel / présentation dans le navigateur (serveur de documents) ----
# Sans serveur de documents, l'application fonctionne normalement : dépôt manuel des annexes, et le bouton
# « Modifier » reste masqué tant qu'aucun moteur n'est configuré. Voir MANIFEST §35 (ONLYOFFICE) et §36 (Collabora).
# Moteur GÉNÉRAL de l'instance : « simulateur » (aucun moteur), « onlyoffice » ou « collabora ». Docker :
# docker compose --profile bureau up -d. Le moteur retenu par un organisme est un réglage `bureau.moteur` : le backend
# construit tous les moteurs déployés et l'administration choisit, organisme par organisme.
BUREAU_MOTEUR=simulateur
# Adresse du moteur vue du BACKEND (réseau Docker : le nom du service). Sert à la conversion PDF.
BUREAU_URL=http://documentserver:8080
# Adresse du moteur vue du NAVIGATEUR. Deux cas, et un seul à retenir :
#   - Docker (recommandé) : /office-delib — le frontal relaie le moteur sous le MÊME nom d'hôte que l'application, donc en
#     HTTPS, sans contenu mixte ni certificat supplémentaire. C'est la valeur à utiliser en production ;
#   - moteur sur un hôte séparé (développement, moteur mutualisé) : une adresse ABSOLUE (http://10.0.0.12:9980).
#     Attention : une application servie en HTTPS qui charge un cadre en HTTP est marquée « Non sécurisé » et peut être
#     bloquée par le navigateur (contenu mixte).
BUREAU_URL_NAVIGATEUR=/office-delib
# Second moteur, au choix par organisme (administration > Pièces jointes). Vide = non déployé, donc non proposé.
# Son adresse navigateur est RELATIVE comme celle d'ONLYOFFICE : le frontal relaie /collabora-delib/ sur le même
# nom d'hôte que l'application. BUREAU_HOTE_PUBLIQUE est le nom d'hôte public, seul lu par le compose (liste des
# hôtes acceptés par Collabora, complétée par BUREAU_HOTE_PUBLIQUE_DEV pour le poste de développement).
# Développement local, moteur sur le serveur (comme ONLYOFFICE, publié sur 9980) : deux différences avec Docker.
#   1. l'adresse navigateur est ABSOLUE et porte le PRÉFIXE, le frontal n'étant pas dans la boucle :
#        BUREAU_COLLABORA_URL_NAVIGATEUR=http://<serveur>:9981/collabora-delib
#      (le moteur refuse toute requête hors de ce préfixe, et hors des hôtes de son `domain` — d'où
#      BUREAU_HOTE_PUBLIQUE_DEV=<serveur> dans le .env DU SERVEUR, sans quoi la découverte est un « Bad request ») ;
#   2. PUBLIC_BASE_URL doit être l'adresse de CE poste, joignable depuis le navigateur : les appels WOPI
#      (CheckFileInfo, GetFile, PutFile) viennent du navigateur, pas du moteur. Tout reste en HTTP, donc pas de
#      contenu mixte ; le port 3021 doit être accessible depuis le poste qui ouvre l'éditeur.
BUREAU_COLLABORA_URL=http://collabora:9980
BUREAU_COLLABORA_URL_NAVIGATEUR=/collabora-delib
BUREAU_COLLABORA_URL_NAVIGATEUR_DEV=http://10.0.0.12:9981/collabora-delib
BUREAU_HOTE_PUBLIQUE=localhost
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=
# Adresse du backend vue du MOTEUR (c'est lui qui appelle pour télécharger la source et pour renvoyer les
# sauvegardes). C'est donc une adresse que le MOTEUR peut joindre, pas la vôtre.
#   - production / Docker : le nom du service et son port interne, identique pour tout le monde ;
#   - développement, application sur un poste et moteur sur un serveur : l'adresse de CE poste sur le réseau que le
#     serveur sait joindre (ex. http://10.103.230.21:3021) — différente à chaque poste, donc à garder dans le .env
#     local (jamais versionné), et le pare-feu du poste doit laisser entrer ce port depuis le serveur.
BUREAU_URL_RAPPEL=http://backend:3021
# Secret de signature partagé avec le moteur (32 caractères ou plus,openssl rand -hex 32) : il authentifie TOUS les
# échanges. Une valeur différente de celle du moteur = rappel refusé.
BUREAU_JWT_SECRET=
BUREAU_LANGUE=fr-FR
# Délai d'attente d'une réponse du moteur (téléchargement, conversion) avant repli local.
BUREAU_DELAI_MS=60000
# ---- Reprise d'historique AIRS DELIB : base Oracle d'origine (lecture seule) ----
# Peut aussi être placé dans le fichier racine .env.airs (ignoré par git).
AIRS_ORACLE_HOST=
AIRS_ORACLE_PORT=1524
AIRS_ORACLE_SERVICE=
AIRS_ORACLE_USER=
AIRS_ORACLE_PASSWORD=
