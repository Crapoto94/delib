# VibeDélib — espace des élus en DMZ (ELU-01, ELU-70). Ne sert QUE le front des élus et ne relaie QUE deux préfixes d'API en liste blanche.
# Aucune base de données, aucun secret ici. Variables : BACKEND_HOST, BACKEND_PORT (le seul port ouvert du pare-feu DMZ -> LAN).
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=300r/m;

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy no-referrer always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'" always;

  # --- API : LISTE BLANCHE (tout le reste est refusé) ---
  location ^~ /api/v1/elus-auth/ {
    limit_req zone=auth burst=10 nodelay;
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_connect_timeout 5s;         # backend injoignable : répondre 502 tout de suite, pas après 60 s de silence
    proxy_http_version 1.1;
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
  }
  location ^~ /api/v1/elus/ {
    limit_req zone=api burst=60 nodelay;
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_connect_timeout 5s;         # backend injoignable : répondre 502 tout de suite, pas après 60 s de silence
    proxy_http_version 1.1;
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;           # attente longue du suivi en direct (25 s) et génération de PDF volumineux (filigrane)
    proxy_buffering off;
  }
  location = /api/status { return 200 '{"status":"ok"}'; add_header Content-Type application/json; }
  # Diagnostic de déploiement : relaie RÉELLEMENT la sonde backend (rien n'est simulé, contrairement à /api/status).
  # Tranche en une commande, sans navigateur et sans DNS, entre « la DMZ n'atteint pas le backend » et
  # « le backend répond mais le navigateur n'aboutit pas » (CSP, instance enregistrée, TLS) :
  #   curl -sS -o /dev/null -w '%{http_code}\n' http://127.0.0.1/api/diag
  # 200 = nginx atteint le backend ; 502/504 = pare-feu, BACKEND_HOST ou BACKEND_PORT ; 404 = route absente du backend.
  location = /api/diag {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT}/api/v1/elus-auth/etat;
    proxy_http_version 1.1;
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s; proxy_read_timeout 10s;
  }
  # Identité publique (nom + logo de la collectivité), lisible avant la connexion : deux routes précises, jamais /api/v1/public/ en entier.
  location = /api/v1/public/branding {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_connect_timeout 5s;         # backend injoignable : répondre 502 tout de suite, pas après 60 s de silence
    proxy_http_version 1.1;
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
  }
  location ~ ^/api/v1/public/organismes/[0-9]+/logo$ {
    proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
    proxy_connect_timeout 5s;         # backend injoignable : répondre 502 tout de suite, pas après 60 s de silence
    proxy_http_version 1.1;
    proxy_set_header Host $host; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Proto $scheme;
  }
  location /api/ { return 404; }       # aucune autre route de l'API interne n'est joignable depuis la DMZ

  # --- front statique ---
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }
  location = /sw.js { add_header Cache-Control "no-cache"; }
  # L'application est servie à la racine de son hôte ; l'adresse historique « …/elus/ » (liens déjà diffusés, copie
  # LAN) sert exactement les mêmes fichiers. Sans cela, les ressources relatives (./assets/…) partent en 404 puis en
  # repli SPA : le navigateur reçoit une page HTML à la place d'un script, refuse de l'exécuter (MIME strict) et
  # affiche une page blanche. `expires -1` (et non add_header) pour ne pas annuler l'héritage des en-têtes de sécurité.
  location = /elus { return 301 /elus/; }
  location ^~ /elus/ {
    alias /usr/share/nginx/html/;
    index index.html;
    expires -1;
  }
  location / { try_files $uri /index.html; add_header Cache-Control "no-cache"; }
}
