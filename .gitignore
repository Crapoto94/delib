# Certificats et clés privées (jamais versionnés)
*.p12
*.pfx
*.pem
*.key
backend/secrets/

# accès serveur : jamais versionnés
SSH.txt
pulldocker.ini
pulldocker-*.ini
pulldmz.ini
pulldmz-*.ini
elus-dmz/.env
# ressources Swagger UI copiees au build (elus-dmz/scripts/copy-swagger-assets.mjs) ; index.html et init.js restent versionnes
